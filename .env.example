# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Jira (서버 사이드 전용 - NEXT_PUBLIC 접두사 없음)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_TARGET_LABEL=planning-request
# 여러 라벨을 쉼표로 구분: planning-request,기획요청
JIRA_PROJECT_KEY=PHAROS
JIRA_CREATE_ISSUE_TYPE=작업

# MCP (AI 도구 연동 - Claude Code/Codex/Claude Desktop 등에서 /api/mcp 호출 시 인증)
MCP_ACCESS_TOKEN=generate-a-random-secret-and-put-it-here
